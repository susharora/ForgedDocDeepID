# Python
__pycache__/
*.pyc
.venv/
venv/

# Data & results (track structure, not contents)
data/raw/*
data/processed/*
results/*
#logs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# OS/editor
.DS_Store
.vscode/
data/FantasyID/*
!data/FantasyID/.gitkeep
external/TruFor/
configs/local.yaml

# ----------------------------------------------------------------------
# Scientific run artifacts
#
# Small provenance/results remain eligible for normal Git:
#   run.yaml
#   experiment_config.yaml
#   logs/
#   metrics/
#   predictions/
#   manifests/
#   checksums
#
# Large/generated binary artifacts remain local by default.
# Selected figures intended for reports should be copied to a tracked
# report/documentation location rather than committing whole run folders.
# ----------------------------------------------------------------------

runs/*/checkpoints/
runs/*/localisation/maps/
runs/*/localisation/rendered/
runs/*/diagnostics/

# Defensive binary-artifact exclusions.
# Force-add only after an explicit project decision.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.onnx
.~lock.*#

# Run visuals — regenerate from checkpoints, don't track
output/**/visuals/
output/**/*.png
!data/processed/policy_c/
!data/processed/policy_c/**
!data/processed/policy_c_official_test/
!data/processed/policy_c_official_test/**

# Long-running LAB adversarial outputs
logs/LABPC/
output/LABPC/trufor_adversarial_localisation_attack/full_population/
output/LABPC/trufor_adversarial_localisation_attack/full_population_shards/
\output/LABPC/trufor_adversarial_localisation_attack/phase2_multigpu_outputs/
output/LABPC/trufor_adversarial_localisation_attack/gpu_capacity_probe/

# ------------------------------------------------------------
# TruFor distributed execution / central-analysis local artifacts
# ------------------------------------------------------------
analysis_transfer_bundles/
execution_fingerprints/analysis_transfer/
output/LABPC/trufor_adversarial_localisation_attack/phase2_multigpu_outputs_shard_*_archive/
output/LABPC/trufor_adversarial_localisation_analysis/phaseA_966/
*:Zone.Identifier
